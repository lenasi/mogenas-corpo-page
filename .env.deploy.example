# Copy to .env and fill in SiteGround SSH details (see Site Tools → Devs → SSH Terminal)

DEPLOY_HOST=ssh.mogenas.com
DEPLOY_USER=
DEPLOY_PORT=18765
DEPLOY_PATH=~/www/mogenas.com/public_html

# Optional: one-time setup via scripts/setup-ssh.sh (remove after key works)
DEPLOY_PASSWORD=

# Saved in ~/.ssh/config by setup-ssh.sh
DEPLOY_SSH_HOST=mogenas-siteground

# Optional: space-separated hosts for npm run purge-cache (default: www + apex)
# PURGE_CACHE_HOSTS=www.mogenas.com mogenas.com
